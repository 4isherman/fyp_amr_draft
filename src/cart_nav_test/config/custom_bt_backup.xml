<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">

      <PipelineSequence name="NavigateWithReplanning">

        <RateController hz="1.0">
          <RecoveryNode number_of_retries="1" name="ComputePathRecovery">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
            <!-- Use DriveOnHeading instead of BackUp — has collision checking -->
            <!-- <DriveOnHeading dist_to_travel="-0.3"
                            speed="-0.1"
                            time_allowance="10"/> -->
            <DriveOnHeading dist_to_travel="-5.5"
                            speed="-0.4"
                            time_allowance="10"/>
          </RecoveryNode>
        </RateController>

        <RecoveryNode number_of_retries="3" name="FollowPathRecovery">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <Sequence name="BackupSequence">
            <!-- Clear costmap AFTER backing up, not before -->
            <!-- <DriveOnHeading dist_to_travel="-0.4"
                            speed="-0.1"
                            time_allowance="10"/> -->
            <DriveOnHeading dist_to_travel="-5.5"
                            speed="-0.4"
                            time_allowance="10"/>
            <ClearEntireCostmap name="ClearLocalCostmap"
                                service_name="local_costmap/clear_entirely_local_costmap"/>
          </Sequence>
        </RecoveryNode>

      </PipelineSequence>

      <Sequence name="GlobalRecovery">
        <!-- Back up first with collision checking -->
        <!-- <DriveOnHeading dist_to_travel="-0.5"
                        speed="-0.08"
                        time_allowance="15"/> -->
        <DriveOnHeading dist_to_travel="-5.5"
                        speed="-0.4"
                        time_allowance="15"/>
        <!-- Then clear stale data -->
        <ClearEntireCostmap name="ClearGlobalCostmap"
                            service_name="global_costmap/clear_entirely_global_costmap"/>
        <ClearEntireCostmap name="ClearLocalCostmap2"
                            service_name="local_costmap/clear_entirely_local_costmap"/>
        <Wait wait_duration="1.0"/>
      </Sequence>

    </RecoveryNode>
  </BehaviorTree>
</root>