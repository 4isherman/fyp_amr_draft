<?xml version="1.0"?>
<robot name="amr">
    <!-- Materials remain the same -->
    <material name="grey">
        <color rgba="0.7 0.7 0.7 1" />
    </material>
    
    <material name="green">
        <color rgba="0 0.6 0 1" />
    </material>

    <material name="white">
        <color rgba="1 1 1 1" />
    </material>

    <material name="black">
        <color rgba="0.1 0.1 0.1 1" />
    </material>

    <material name="blue">
        <color rgba="0 0.2 0.8 1" />
    </material>

    
    <link name="base_footprint" />

    <!-- Base Link with Proper Inertial Properties -->
    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.3 0.3 0.15" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="green" />
        </visual>

        <collision>
            <geometry>
                <box size="0.3 0.3 0.15" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="2.0" />
            <!-- Box inertia: I = (1/12) * m * (h^2 + d^2) -->
            <inertia
                ixx="0.01875"
                iyy="0.01875"
                izz="0.03"
                ixy="0"
                ixz="0"
                iyz="0"/>
        </inertial>
    </link>

    <!-- 3D Lidar Link with Proper Inertial Properties -->
    <link name="lidar_3d">
        <visual>
            <geometry>
                <cylinder radius="0.075" length="0.065" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="white" />
        </visual>

        <collision>
            <geometry>
                <cylinder radius="0.075" length="0.065" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.2" />
            <inertia 
                ixx="0.0003517"
                iyy="0.0003517"
                izz="0.0005625"
                ixy="0"
                ixz="0"
                iyz="0"/>
        </inertial>
    </link>

    <!-- Depth Camera Link -->
    <link name="camera_link">
        <visual>
            <geometry>
                <box size="0.03 0.1 0.03" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="blue" />
        </visual>

        <collision>
            <geometry>
                <box size="0.03 0.1 0.03" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.05" />
            <inertia 
                ixx="0.00004542"
                iyy="0.0000075"
                izz="0.00004542"
                ixy="0"
                ixz="0"
                iyz="0"/>
        </inertial>
    </link>

    <!-- Depth Camera Optical Frame -->
    <link name="camera_depth_frame" />

    <!-- IMU Link -->
    <link name="imu_link">
        <visual>
            <geometry>
                <box size="0.02 0.02 0.01" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="grey" />
        </visual>

        <!-- <collision>
            <geometry>
                <box size="0.02 0.02 0.01" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision> -->

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.01" />
            <inertia 
                ixx="4.167e-7"
                iyy="4.167e-7"
                izz="6.667e-7"
                ixy="0"
                ixz="0"
                iyz="0"/>
        </inertial>
    </link>

    <!-- GPS/NavSat Link -->
    <link name="navsat_link">
        <visual>
            <geometry>
                <box size="0.05 0.05 0.02" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="black" />
        </visual>

        <collision>
            <geometry>
                <box size="0.05 0.05 0.02" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.02" />
            <inertia 
                ixx="0.000004833"
                iyy="0.000004833"
                izz="0.000008333"
                ixy="0"
                ixz="0"
                iyz="0"/>
        </inertial>
    </link>

    <!-- Left Wheel with Proper Inertial Properties -->
    <link name="front_left_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.05" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0" />
            <material name="grey" />
        </visual>

        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.05" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0" />
            <surface>
                <!-- This friction pamareter don't contain reliable data!! -->
                <friction>
                    <ode>
                        <mu>100000.0</mu>
                        <mu2>100000.0</mu2>
                        <fdir1>0 0 0</fdir1>
                        <slip1>0.0</slip1>
                        <slip2>0.0</slip2>
                    </ode>
                </friction>
                <contact>
                    <ode>
                        <soft_cfm>0</soft_cfm>
                        <soft_erp>0.2</soft_erp>
                        <kp>1e+5</kp>
                        <kd>1</kd>
                        <max_vel>0.01</max_vel>
                        <min_depth>0.001</min_depth>
                    </ode>
                </contact>
            </surface>
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="1.57 0 0" />
            <mass value="0.2" />
            <inertia
                ixx="0.00016667"
                iyy="0.00016667"
                izz="0.00025"
                ixy="0"
                ixz="0"
                iyz="0"/>
        </inertial>
    </link>

    <!-- Right Wheel with Proper Inertial Properties -->
    <link name="front_right_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.05" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0" />
            <material name="grey" />
        </visual>

        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.05" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0" />
            <surface>
                <!-- This friction pamareter don't contain reliable data!! -->
                <friction>
                    <ode>
                        <mu>100000.0</mu>
                        <mu2>100000.0</mu2>
                        <fdir1>0 0 0</fdir1>
                        <slip1>0.0</slip1>
                        <slip2>0.0</slip2>
                    </ode>
                </friction>
                <contact>
                    <ode>
                        <soft_cfm>0</soft_cfm>
                        <soft_erp>0.2</soft_erp>
                        <kp>1e+5</kp>
                        <kd>1</kd>
                        <max_vel>0.01</max_vel>
                        <min_depth>0.001</min_depth>
                    </ode>
                </contact>
            </surface>
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="1.57 0 0" />
            <mass value="0.2" />
            <inertia
                ixx="0.00016667"
                iyy="0.00016667"
                izz="0.00025"
                ixy="0"
                ixz="0"
                iyz="0"/>
        </inertial>
    </link>

        <!-- Caster Wheel -->
    <link name="caster_wheel">
        <visual>
            <geometry>
                <sphere radius="0.025"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="grey" />
        </visual>

        <collision>
            <geometry>
                <sphere radius="0.025"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <surface>
                <contact>
                    <ode>
                    <soft_cfm>0</soft_cfm>
                    <soft_erp>0.2</soft_erp>
                    <kp>1e+5</kp>
                    <kd>1</kd>
                    <max_vel>0.01</max_vel>
                    <min_depth>0.001</min_depth>
                    </ode>
                </contact>
            </surface>
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.05" />
            <!-- Cylinder about Y-axis (rotated): r=0.1, h=0.05 -->
            <inertia
                ixx="0.000020833"
                iyy="0.000020833"
                izz="0.000020833"
                ixy="0"
                ixz="0"
                iyz="0"/>
        </inertial>
    </link>

    <!-- Joints remain the same -->
    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <joint name="base_lidar_3d_joint" type="fixed">
        <parent link="base_link" />
        <child link="lidar_3d" />
        <origin xyz="0 0 0.11" rpy="0 0 0" />
    </joint>

    <joint name="camera_joint" type="fixed">
        <parent link="base_link" />
        <child link="camera_link" />
        <origin xyz="0.17 0 0" rpy="0 0 0" />
    </joint>

    <joint name="camera_depth_joint" type="fixed">
        <parent link="camera_link" />
        <child link="camera_depth_frame" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <joint name="imu_joint" type="fixed">
        <parent link="base_link" />
        <child link="imu_link" />
        <origin xyz="-0.1 0 0.079" rpy="0 0 0" />
    </joint>

    <joint name="navsat_joint" type="fixed">
        <parent link="base_link" />
        <child link="navsat_link" />
        <origin xyz="0.11 0 0.085" rpy="0 0 0" />
    </joint>

    <joint name="base_front_left_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="front_left_wheel" />
        <origin xyz="0.075 0.175 -0.075" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <!-- <dynamics damping="0.1" friction="0.0"/> -->
    </joint>

    <joint name="base_front_right_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="front_right_wheel" />
        <origin xyz="0.075 -0.175 -0.075" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <!-- <dynamics damping="0.1" friction="0.0"/> -->
    </joint>

    <joint name="caster_wheel_joint" type="fixed">
        <parent link="base_link" />
        <child link="caster_wheel" />
        <origin xyz="-0.1225 0 -0.1" rpy="0 0 0" />
    </joint>

    <!-- Gazebo materials -->
    <gazebo reference="base_link">
        <material>Gazebo/Green</material>
    </gazebo>

    <gazebo reference="lidar_3d">
        <material>Gazebo/White</material>
    </gazebo>

    <gazebo reference="camera_link">
        <material>Gazebo/Black</material>
    </gazebo>

    <gazebo reference="imu_link">
        <material>Gazebo/Grey</material>
    </gazebo>

    <gazebo reference="navsat_link">
        <material>Gazebo/Black</material>
    </gazebo>

    <gazebo reference="front_left_wheel">
        <material>Gazebo/Grey</material>
        <!-- <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>1.0</maxVel> -->
    </gazebo>

    <gazebo reference="front_right_wheel">
        <material>Gazebo/Grey</material>
        <!-- <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>1.0</maxVel> -->
    </gazebo>

    <!-- Sensors remain the same -->
    <gazebo reference="lidar_3d">
        <sensor name="lidar_3d_sensor" type="gpu_lidar">
            <topic>/lidar_3d</topic>
            <update_rate>15</update_rate>
            <gz_frame_id>lidar_3d</gz_frame_id>
            <lidar>
                <scan>
                    <horizontal>
                        <!-- <samples>720</samples> -->
                        <samples>200</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14</min_angle>
                        <max_angle>3.14</max_angle>
                    </horizontal>
                    <vertical>
                        <!-- <samples>64</samples> -->
                        <samples>32</samples>
                        <resolution>1</resolution>
                        <min_angle>-0.26</min_angle>
                        <max_angle>0.26</max_angle>
                    </vertical>
                </scan>
                <range>
                    <min>0.15</min>
                    <max>10.0</max>
                </range>
            </lidar>
            <always_on>true</always_on>
        </sensor>
    </gazebo>

    <gazebo reference="camera_link">
        <sensor name="depth_camera" type="depth_camera">
            <update_rate>15</update_rate>
            <topic>/camera</topic>
            <gz_frame_id>camera_link</gz_frame_id>
            <camera>
                <horizontal_fov>1.5708</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>10.0</far>
                </clip>
            </camera>
            <always_on>1</always_on>
        </sensor>
    </gazebo>

    <gazebo reference="imu_link">
        <sensor name="imu_sensor" type="imu">
            <update_rate>200</update_rate>
            <topic>/imu</topic>
            <gz_frame_id>imu_link</gz_frame_id>
            <always_on>1</always_on>
            <imu>
                <orientation_reference_frame>
                    <localization>ENU</localization>
                </orientation_reference_frame>
                <angular_velocity>
                    <x><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></x>
                    <y><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></y>
                    <z><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></z>
                </angular_velocity>
                <linear_acceleration>
                    <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></x>
                    <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></y>
                    <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></z>
                </linear_acceleration>
            </imu>
        </sensor>
    </gazebo>

    <gazebo reference="navsat_link">
        <sensor name="navsat" type="navsat">
            <always_on>1</always_on>
            <update_rate>10</update_rate>
            <topic>/navsat</topic>
            <gz_frame_id>navsat_link</gz_frame_id>
        </sensor>
    </gazebo>

    <!-- Differential Drive Plugin -->
    <gazebo>
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <left_joint>base_front_left_wheel_joint</left_joint>
            <right_joint>base_front_right_wheel_joint</right_joint>

            <wheel_separation>0.35</wheel_separation>
            <wheel_radius>0.05</wheel_radius>

            <max_linear_acceleration>1.0</max_linear_acceleration>

            <topic>/cmd_vel</topic>

            <odom_topic>/odom</odom_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id>
            <odom_publish_frequency>30</odom_publish_frequency>

            <!-- <tf_topic>/tf</tf_topic> -->
        </plugin>
    </gazebo>
</robot>